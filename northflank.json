{
  "name": "wingo-data-platform",
  "description": "WinGo 30S 24/7 Data Collector & Historical Analytics Platform",
  "services": [
    {
      "name": "wingo-collector",
      "type": "deployment",
      "dockerfile": "Dockerfile",
      "command": "python -m app.collector",
      "environment": {
        "APP_ENV": "production",
        "SOURCE_URL": "https://draw.ar-lottery01.com/WinGo/WinGo_30S/GetHistoryIssuePage.json",
        "POLL_INTERVAL_SECONDS": "5",
        "LOG_LEVEL": "INFO",
        "LOG_FORMAT": "json",
        "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
        "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
        "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
        "OPENROUTER_MODEL": "meta-llama/llama-3.1-70b-instruct",
        "AI_PROVIDERS": "nvidia,openrouter,groq,gemini",
        "AI_MAX_REQUESTS_PER_CYCLE": "1",
        "AI_TIMEOUT_SECONDS": "3.0",
        "AI_MAX_RETRIES": "1",
        "AI_PROVIDER_COOLDOWN_SECONDS": "60.0"
      }
    },
    {
      "name": "wingo-api",
      "type": "deployment",
      "dockerfile": "Dockerfile",
      "command": "uvicorn app.api.main:app --host 0.0.0.0 --port ${PORT:-8000}",
      "ports": [
        {
          "name": "http",
          "port": 8000,
          "public": true
        }
      ],
      "environment": {
        "APP_ENV": "production",
        "LOG_LEVEL": "INFO",
        "LOG_FORMAT": "json",
        "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
        "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
        "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
        "OPENROUTER_MODEL": "meta-llama/llama-3.1-70b-instruct",
        "AI_PROVIDERS": "nvidia,openrouter,groq,gemini",
        "AI_MAX_REQUESTS_PER_CYCLE": "1",
        "AI_TIMEOUT_SECONDS": "3.0",
        "AI_MAX_RETRIES": "1",
        "AI_PROVIDER_COOLDOWN_SECONDS": "60.0"
      }
    }
  ],
  "jobs": [
    {
      "name": "database-maintenance",
      "schedule": "0 2 * * *",
      "dockerfile": "Dockerfile",
      "command": "python -m app.database.maintenance"
    }
  ]
}
