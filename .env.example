# Environment
APP_ENV=development

# Source API
SOURCE_URL=https://draw.ar-lottery01.com/WinGo/WinGo_30S/GetHistoryIssuePage.json
SOURCE_API_URL=https://api.ar-lottery01.com/api/Lottery/GetHistoryIssuePage

# Collector Settings
POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wingo_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wingo_db

# Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# API Security
API_KEY=your-secret-api-key-change-me

# CORS
CORS_ORIGINS=chrome-extension://your-extension-id

# Cache TTLs (seconds)
CACHE_LATEST_TTL=3
CACHE_SUMMARY_TTL=10
CACHE_ANALYTICS_TTL=30

# Retention
RAW_RESPONSE_RETENTION_DAYS=30

# Monitoring
HEALTH_DEGRADED_THRESHOLD_SECONDS=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Provider Configurations
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

AI_PROVIDERS=nvidia,openrouter,groq,gemini
AI_MAX_REQUESTS_PER_CYCLE=1
AI_TIMEOUT_SECONDS=3.0
AI_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=60.0

# Server
HOST=0.0.0.0
PORT=8000
